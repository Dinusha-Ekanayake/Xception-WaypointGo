# Root Compose template. Spring started with Maven/Java requires exported settings.
# Local Next.js uses frontend/.env.local with BACKEND_URL only.
# Server-only. Never NEXT_PUBLIC_*. Never commit real secrets.
# Spring runtime, import-reference and account-create use DATABASE_URL.
# Neon: pooled URL with TLS settings for runtime. In a deployment this logs in
# as waypoint_app, which owns nothing; `migrate` sets its password from here.
DATABASE_URL=postgresql://USER:PASSWORD@POOLED_HOST/DATABASE?sslmode=require
# The connection `migrate` logs in with, read by nothing else: the cluster's own
# account, or waypoint_migrator once it has been given a password. Either way
# the migrations run as waypoint_migrator, which owns the schema and is not a
# superuser. Leave unset for local development, where DATABASE_URL does both.
# MIGRATION_DATABASE_URL=postgresql://OWNER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require
# Direct URL for backup scripts and legacy Node db:migrate.
# Java migrations do not read this variable; see MIGRATION_DATABASE_URL.
# Neon: direct hostname without -pooler.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require

# ─── Local hybrid development (docs/development.md) ───
# `docker compose up -d db` runs PostgreSQL alone on 127.0.0.1:5432 while the
# backend and frontend run natively. Export this in the backend shell; Spring
# does not read this file. Create the test database once with:
#   docker compose exec db createdb -U waypoint waypoint_test
# DATABASE_URL=postgresql://waypoint:local-testing-only@127.0.0.1:5432/waypoint
# Optional: also write backend logs as JSON to var/log for the log store
# (`docker compose --profile observability up -d`). Path is relative to backend/.
# LOG_FILE=../var/log/backend.log

# Already-created disposable database for tests only. Must differ from DATABASE_URL.
TEST_DATABASE_URL=postgresql://waypoint:local-testing-only@localhost:5432/waypoint_test
# Password for the demo accounts `docker compose up` creates (scripts/compose-init.sh).
# At least 12 characters. This is the demo password the README names; use a
# private value before exposing the instance.
# Re-running init never resets an existing account's password.
SEED_PASSWORD=123456789123
# Local Docker only: host port for PostgreSQL, if 5432 is taken.
DB_PORT=5432
# The session cookie is Secure and named __Host-waypoint_session unless this is 0.
# 0 is for local development over plain HTTP only; the backend defaults to 1.
COOKIE_SECURE=0
# Read-only MCP connections, local stdio and remote assistants. Disabled unless
# explicitly enabled. Preview: MCP_ENABLED=true with the preview MCP_PUBLIC_URL
# below. Production: the same two lines with the production URL, after the
# preview connection is verified with Claude or ChatGPT.
MCP_ENABLED=false
# MCP requests a minute (P-30, R-IAM-33). One tool call is about two requests.
MCP_RATE_PER_CREDENTIAL=120
MCP_RATE_PER_CLIENT=1200
# Confirmed MCP writes an hour per connection (P-32, R-IAM-35), prepare and confirm each count.
MCP_WRITES_PER_HOUR=30
# Origins a state-changing request may come from, beyond the host it was sent
# to. Comma separated. Usually empty: every role address is its own host.
# ALLOWED_ORIGINS=https://console.example.com
# Local Docker only. Host port for `compose.yaml`; container uses internal db host.
PORT=3000
# Where the Next.js UI proxies /api/* (Spring Boot backend). In Docker the
# `waypoint` service sets BACKEND_URL=http://backend:8080 automatically.
BACKEND_URL=http://127.0.0.1:8080
# Live map tiles, read by the Next server only (frontend/app/map-tiles). A
# template with {z}, {x}, {y}; any key stays server side. Unset: the maps draw
# with no base layer and say "Base map unavailable". tile.openstreetmap.org is
# for local development only; its usage policy forbids production traffic.
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Host port for the Spring Boot backend in `compose.yaml`.
BACKEND_PORT=8080
# VPS deployment only (`deploy/vps/compose.vps.yaml` + nginx): the public
# hostname of this environment. nginx also serves the preview at preview.<it>.
SITE_ADDRESS=dispatch.example.com
# VPS production only. 1 drops requests that did not come through Cloudflare;
# set it only after the DNS records are proxied.
# CLOUDFLARE_ONLY=1
# VPS only. Unset means production (main); `preview` in the dev checkout.
# DEPLOY_ENV=preview
# Local Docker PostgreSQL owner password (compose.yaml db and init services).
# Replace before exposing a Docker deployment; not used by Vercel/Neon.
POSTGRES_PASSWORD=local-testing-only
# Password of waypoint_app, the role the backend logs in as (compose.yaml init
# and backend services). Hex or other URL-safe characters only. On the VPS,
# deploy/vps/deploy.sh generates it the first time it is missing.
APP_DB_PASSWORD=local-testing-only-app

# ─── External warehouse API (backend only) ───
# Docs: https://triathon-warehouse-simple.vercel.app/docs
# Create a personal key on the service's "API keys" page; each developer uses
# their own, so usage and revocation stay per person. Sent as `x-api-key`.
# Blank is allowed: every placement then saves as STOCK_UNKNOWN, visibly.
# Server-only: never NEXT_PUBLIC_*, never in frontend/.env.local.
WAREHOUSE_BASE_URL=https://triathon-warehouse-simple.vercel.app/api/v1
WAREHOUSE_API_KEY=
# Placement budget: a store manager is waiting (MODULES: 2 s).
WAREHOUSE_TIMEOUT_MS=2000
# Older than this the catalogue is shown as stale.
WAREHOUSE_CATALOGUE_STALE_AFTER=2h
# HMAC-SHA256 secret shared with the warehouse for its webhook. Blank turns the
# webhook off; status polling covers it. Server-only, never NEXT_PUBLIC_*.
WAREHOUSE_WEBHOOK_SECRET=

# Production: log as ECS JSON for the log store. Off locally for readable output.
LOG_FORMAT=ecs
# Tracing export (off unless both set). TRACE_SAMPLE is 0.0 to 1.0.
OTLP_EXPORT=false
OTLP_ENDPOINT=
TRACE_SAMPLE=0.1

# Log store (opt-in `observability` profile: Loki, Alloy, Grafana).
# Grafana listens on 127.0.0.1 only. Required in production before enabling it.
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_A_PRIVATE_PASSWORD
GRAFANA_PORT=3001
# Where Alertmanager sends alerts: a Slack-compatible incoming webhook (Slack,
# Mattermost, Rocket.Chat, or a Discord webhook with /slack at the end). Empty
# means the alerts show only on Prometheus and in Grafana.
ALERT_WEBHOOK_URL=

# Outbox relay: delivers committed events between modules. On by default; an
# event is dead-lettered after RELAY_MAX_ATTEMPTS failed deliveries.
# RELAY_ENABLED=true
# RELAY_MAX_ATTEMPTS=8

# Proof of delivery. Photos and signatures are kept in the database by default
# (PROOF_STORE=database). PROOF_STORE=local keeps them as files under PROOF_DIR
# instead: a persistent volume in the compose files, ../var/proofs when run
# natively. The database store still reads files written there before.
# PROOF_STORE=database
# PROOF_URL_SECRET signs the short-lived links they are read through; at least
# 16 characters. Unset, links stop working whenever the backend restarts.
# PROOF_DIR=
PROOF_URL_SECRET=

# Web push for notifications. Both blank turns push off; the inbox still works and
# the API says push is unavailable. Generate a pair with
# `npx web-push generate-vapid-keys` (base64url). The private key is a secret.
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
# A contact the browser push services can reach, mailto: or https://.
# PUSH_SUBJECT=mailto:operations@example.com

# The model service (issue #16). Compose points the backend at the ml container;
# set it blank to run with no model, and every plan says it was scored without one.
# ML_BASE_URL=http://ml:8000
# Models trained on the competition data (datathon-...) may answer only where this
# is true. Leave it true for the judge build and preview; set false in production,
# where only models trained on our own deliveries may answer (R-ML-09).
# ML_ALLOW_DATATHON=true

# Canonical public remote MCP resource. Blank disables remote OAuth.
# Preview checkout: MCP_PUBLIC_URL=https://preview.waypointgo.live/mcp
# Production checkout: MCP_PUBLIC_URL=https://waypointgo.live/mcp
# Use the shared host, never a role address. Backend and adapter read the same
# file, so one line configures both. HTTPS required outside loopback.
MCP_PUBLIC_URL=

# Optional: the language model gateway (roadmap AI-0). It rewords the
# dispatcher's plan explanations; the rules' text is always there without it.
# Off unless AI_ENABLED=true. Only the backend holds the key. What is sent:
# the explanation's allow-listed fields (store and vehicle codes, counts, the
# rules' wording), with phone numbers, identity numbers, e-mails and links
# masked; every call is recorded in ml.ai_calls. AI_DAILY_CALLS caps the calls
# a day; also set a credit limit on the provider's key. Production stays off
# until the business owner agrees (no personal data is sent, but plans are
# commercially confidential). Never commit a real key.
AI_ENABLED=false
# groq or openrouter
AI_PROVIDER=groq
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Pinned model; blank takes qwen/qwen3.8-27b (Groq) or google/gemini-2.5-flash-lite (OpenRouter).
# Groq retired llama-3.1-8b-instant: a pin to it answers 404 and every call fails. Measure a
# new pin with backend AiLiveEvaluation (docs/issues/watch-review/PLAN.md) before changing it.
# AI_MODEL=
# AI_DAILY_CALLS=300
# Jev in shadow (roadmap AI-J1, R-ML-33): it guesses each new issue's type, and each
# typed trip-chat report's situation, from masked words through OPENROUTER_API_KEY;
# the guess is kept beside the real one in ml.jev_shadow. Agreed for production in
# shadow on 2026-10-21. Nobody sees it; it measures Jev before it may advise anyone.
# Pinned, never ~jev-latest.
JEV_ENABLED=false
# JEV_MODEL=typesafe/jev-1.13

# Text to speech on our own server (R-MSG-10, speech/README.md): Piper with an
# English, a Sinhala and a Tamil voice; nothing leaves the server. Start it with
# `docker compose --profile speech up -d speech` and set the URL. Blank leaves it
# off, and phones read messages with their own voice, saying so.
# SPEECH_URL=http://speech:8090
# SPEECH_MEM=1g

# F-15: memory ceilings per container (docs/deployment.md, Operational limits).
# Raise one when its service needs it; never remove them.
# DB_MEM=1g
# BACKEND_MEM=2g
# ML_MEM=1536m
# WEB_MEM=512m
# MCP_MEM=256m
# INIT_MEM=1g

# Object store (roadmap M-01). Any S3-compatible service: Cloudflare R2
# (recommended), Backblaze B2, AWS S3, Oracle. Paste the four values below and
# set OBJECT_STORE=s3: new proof photos and signatures go to the bucket, older
# ones are still read from the database. Blank or database keeps everything in
# the database; with s3 and a value missing the backend refuses to start.
# Profile photos, voice notes and Fuel Passes stay in the database for now.
# For R2 the endpoint is https://<account-id>.r2.cloudflarestorage.com and the
# region is auto; for AWS, https://s3.<region>.amazonaws.com and that region.
OBJECT_STORE=
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Required with OBJECT_STORE=s3: every file is encrypted with it before upload.
# openssl rand -base64 32. Keep a copy with the database backups: without it the
# files cannot be read. Never put it in the bucket or the repository.
S3_ENCRYPTION_KEY=

# Voice note transcription (roadmap FF-05). Pick one engine and paste its key:
# TRANSCRIBE_ENGINE=gemini (GEMINI_API_KEY, from Google AI Studio) is the engine built
# so far; the Azure keys below are kept for a later one. TRANSCRIBE_MODEL picks the
# Gemini model (default gemini-3.8-flash: about a minute a note, place names right;
# a lite model is seconds but heard "Kandy" as "candy"). Empty is off: notes still
# play, with "no transcript, play audio". Recordings leave the country: production needs
# the data processing agreement first (policy P-PD-1).
TRANSCRIBE_ENGINE=
GEMINI_API_KEY=
TRANSCRIBE_MODEL=gemini-3.8-flash
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Roadmap T1-01: the late-risk review on the Publish step (dispatcher, labelled
# an estimate until the trust gates pass). false hides it.
PUBLISH_RISK_REVIEW=true

# Demo sign-in for judges: the sign-in page offers these accounts to pick and
# the loader's PIN screen offers the PIN, so nobody copies credentials. Off
# unless accounts and password are set, and shown only while an administrator
# has demo mode on. An account is offered only while this password signs it in,
# so an account whose password was changed is never listed. Field roles
# (dispatcher, driver, store manager, loader) are offered; an administrator only
# with DEMO_SIGN_IN_ADMIN=true (it changes accounts and policies, and the list is
# public); an auditor or operations account never. Use the seed
# password, never a real one. DEMO_SIGN_IN_UNTIL (a date, Colombo) ends it on its
# own after judging. Example:
# DEMO_SIGN_IN_ACCOUNTS=dinushabawantha@waypoint.local,rashmikadilshan@waypoint.local,ransikaj@waypoint.local,peliyagoda@waypoint.local,admin@waypoint.local
# DEMO_SIGN_IN_UNTIL=2026-10-31
DEMO_SIGN_IN_ACCOUNTS=
DEMO_SIGN_IN_PASSWORD=
DEMO_SIGN_IN_PIN=
DEMO_SIGN_IN_ADMIN=false
DEMO_SIGN_IN_UNTIL=
