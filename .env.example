# Root Compose template. Spring started with Maven/Java requires exported settings.
# Local Next.js uses frontend/.env.local with BACKEND_URL only.
# Server-only. Never NEXT_PUBLIC_*. Never commit real secrets.
# Spring runtime, import-reference and account-create use DATABASE_URL.
# Neon: pooled URL with TLS settings for runtime. In a deployment this logs in
# as waypoint_app, which owns nothing; `migrate` sets its password from here.
DATABASE_URL=postgresql://USER:PASSWORD@POOLED_HOST/DATABASE?sslmode=require
# The connection `migrate` logs in with, read by nothing else: the cluster's own
# account, or waypoint_migrator once it has been given a password. Either way
# the migrations run as waypoint_migrator, which owns the schema and is not a
# superuser. Leave unset for local development, where DATABASE_URL does both.
# MIGRATION_DATABASE_URL=postgresql://OWNER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require
# Direct URL for backup scripts and legacy Node db:migrate.
# Java migrations do not read this variable; see MIGRATION_DATABASE_URL.
# Neon: direct hostname without -pooler.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require

# ─── Local hybrid development (docs/development.md) ───
# `docker compose up -d db` runs PostgreSQL alone on 127.0.0.1:5432 while the
# backend and frontend run natively. Export this in the backend shell; Spring
# does not read this file. Create the test database once with:
#   docker compose exec db createdb -U waypoint waypoint_test
# DATABASE_URL=postgresql://waypoint:local-testing-only@127.0.0.1:5432/waypoint
# Optional: also write backend logs as JSON to var/log for the log store
# (`docker compose --profile observability up -d`). Path is relative to backend/.
# LOG_FILE=../var/log/backend.log

# Already-created disposable database for tests only. Must differ from DATABASE_URL.
TEST_DATABASE_URL=postgresql://waypoint:local-testing-only@localhost:5432/waypoint_test
# Password for the demo accounts `docker compose up` creates (scripts/compose-init.sh).
# At least 12 characters; use a private value before exposing the instance.
# Re-running init never resets an existing account's password.
SEED_PASSWORD=REPLACE_WITH_A_PRIVATE_PASSWORD
# Local Docker only: host port for PostgreSQL, if 5432 is taken.
DB_PORT=5432
# The session cookie is Secure and named __Host-waypoint_session unless this is 0.
# 0 is for local development over plain HTTP only; the backend defaults to 1.
COOKIE_SECURE=0
# Origins a state-changing request may come from, beyond the host it was sent
# to. Comma separated. Usually empty: every role address is its own host.
# ALLOWED_ORIGINS=https://console.example.com
# Local Docker only. Host port for `compose.yaml`; container uses internal db host.
PORT=3000
# Where the Next.js UI proxies /api/* (Spring Boot backend). In Docker the
# `waypoint` service sets BACKEND_URL=http://backend:8080 automatically.
BACKEND_URL=http://127.0.0.1:8080
# Host port for the Spring Boot backend in `compose.yaml`.
BACKEND_PORT=8080
# Production only (`compose.prod.yaml` + nginx): public hostname with DNS
# pointed at the host, and a contact for Let's Encrypt expiry notices.
DOMAIN=dispatch.example.com
CERTBOT_EMAIL=ops@example.com
# VPS deployment only (`deploy/vps/compose.vps.yaml` + nginx): the public
# hostname of this environment. nginx also serves the preview at preview.<it>.
SITE_ADDRESS=dispatch.example.com
# VPS production only. 1 drops requests that did not come through Cloudflare;
# set it only after the DNS records are proxied.
# CLOUDFLARE_ONLY=1
# VPS only. Unset means production (main); `preview` in the dev checkout.
# DEPLOY_ENV=preview
# Local Docker PostgreSQL owner password (compose.yaml db and init services).
# Replace before exposing a Docker deployment; not used by Vercel/Neon.
POSTGRES_PASSWORD=local-testing-only
# Password of waypoint_app, the role the backend logs in as (compose.yaml init
# and backend services). Hex or other URL-safe characters only. On the VPS,
# deploy/vps/deploy.sh generates it the first time it is missing.
APP_DB_PASSWORD=local-testing-only-app

# ─── External warehouse API (backend only) ───
# Docs: https://triathon-warehouse-simple.vercel.app/docs
# Create a personal key on the service's "API keys" page; each developer uses
# their own, so usage and revocation stay per person. Sent as `x-api-key`.
# Blank is allowed: every placement then saves as STOCK_UNKNOWN, visibly.
# Server-only: never NEXT_PUBLIC_*, never in frontend/.env.local.
WAREHOUSE_BASE_URL=https://triathon-warehouse-simple.vercel.app/api/v1
WAREHOUSE_API_KEY=
# Placement budget: a store manager is waiting (MODULES: 2 s).
WAREHOUSE_TIMEOUT_MS=2000
# Older than this the catalogue is shown as stale.
WAREHOUSE_CATALOGUE_STALE_AFTER=2h
# HMAC-SHA256 secret shared with the warehouse for its webhook. Blank turns the
# webhook off; status polling covers it. Server-only, never NEXT_PUBLIC_*.
WAREHOUSE_WEBHOOK_SECRET=

# Production: log as ECS JSON for the log store. Off locally for readable output.
LOG_FORMAT=ecs
# Tracing export (off unless both set). TRACE_SAMPLE is 0.0 to 1.0.
OTLP_EXPORT=false
OTLP_ENDPOINT=
TRACE_SAMPLE=0.1

# Log store (opt-in `observability` profile: Loki, Alloy, Grafana).
# Grafana listens on 127.0.0.1 only. Required in production before enabling it.
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_A_PRIVATE_PASSWORD
GRAFANA_PORT=3001

# Outbox relay: delivers committed events between modules. On by default; an
# event is dead-lettered after RELAY_MAX_ATTEMPTS failed deliveries.
# RELAY_ENABLED=true
# RELAY_MAX_ATTEMPTS=8

# Proof of delivery. Photos and signatures are kept in the database by default
# (PROOF_STORE=database). PROOF_STORE=local keeps them as files under PROOF_DIR
# instead: a persistent volume in the compose files, ../var/proofs when run
# natively. The database store still reads files written there before.
# PROOF_STORE=database
# PROOF_URL_SECRET signs the short-lived links they are read through; at least
# 16 characters. Unset, links stop working whenever the backend restarts.
# PROOF_DIR=
PROOF_URL_SECRET=
