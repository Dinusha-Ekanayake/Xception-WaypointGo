{
  "name": "waypoint-dispatch",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build --webpack && node scripts/build-sw.mjs",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:legacy && npm run test:spring",
    "test:e2e": "npm run backend:build && node --experimental-strip-types scripts/test-e2e.ts",
    "verify": "npm test && npm run typecheck && npm run build && npm run test:e2e",
    "db:migrate": "node --experimental-strip-types scripts/database.ts migrate",
    "db:seed": "node --experimental-strip-types scripts/database.ts seed",
    "test:legacy": "node --test --experimental-strip-types tests/*.test.ts",
    "backend:build": "mvn -q -f ../backend/pom.xml package",
    "test:spring": "npm run backend:build && node --test --experimental-strip-types tests/spring/*.test.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.0",
    "@fontsource/instrument-sans": "^5.2.0",
    "@next/env": "^16.3.6",
    "@vercel/functions": "^3.9.9",
    "csv-parse": "^6.1.0",
    "next": "^16.0.0",
    "pg": "^8.23.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
