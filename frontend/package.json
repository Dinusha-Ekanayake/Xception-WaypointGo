{
  "name": "waypoint-dispatch",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build --webpack && node scripts/build-sw.mjs",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "backend:build": "mvn -q -f ../backend/pom.xml package",
    "verify": "npm test && npm run typecheck && npm run build && npm run backend:test",
    "test:e2e": "playwright test",
    "backend:test": "mvn -q -B -f ../backend/pom.xml verify"
  },
  "dependencies": {
    "@fontsource-variable/google-sans-flex": "^5.3.1",
    "@fontsource/ibm-plex-mono": "^5.2.0",
    "@fontsource/instrument-sans": "^5.2.0",
    "@next/env": "^16.3.6",
    "leaflet": "^1.9.4",
    "next": "^16.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
