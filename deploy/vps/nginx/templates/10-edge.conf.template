# Edge configuration for both environments. Rendered at container start by the
# stock nginx entrypoint, which substitutes only SITE_ADDRESS and
# CLOUDFLARE_ONLY; every other $variable is nginx's own.
#
#   visitor --HTTPS--> [Cloudflare] --HTTPS--> nginx --http--> frontend:3000
#
# /api/* is proxied on to Spring by the Next.js catch-all route, so no backend
# is reachable from outside. Each frontend is reached over the `waypoint-edge`
# network by an alias named after its environment.

server_tokens off;

# Docker's DNS. Upstreams are named through variables below, so a recreated
# frontend container is found again within seconds instead of at next restart.
resolver 127.0.0.11 valid=10s ipv6=off;

# CLOUDFLARE_ONLY=1 refuses any request that did not come through Cloudflare.
# Leave it 0 until the DNS records are proxied, or the site is unreachable.
map "${CLOUDFLARE_ONLY}:$trusted_peer" $deny_direct {
  default 0;
  "1:0" 1;
}

# Sign-in attempts are POSTs; resolving a session is a GET on the same path and
# happens on every page load, so only POSTs count against the sign-in limit.
map $http_upgrade $connection_upgrade {
  default upgrade;
  ""      "";
}

map $request_method $signin_key {
  default "";
  POST $binary_remote_addr;
}

limit_req_zone $signin_key zone=signin:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=api:10m rate=30r/s;
limit_req_zone $binary_remote_addr zone=pages:10m rate=50r/s;
limit_conn_zone $binary_remote_addr zone=perip:10m;
limit_req_status 429;
limit_conn_status 429;

# Matches the backend's 4MB limit; proof photos are the largest request.
client_max_body_size 4m;
client_body_timeout 15s;
client_header_timeout 15s;
send_timeout 30s;

gzip on;
gzip_vary on;
gzip_proxied any;
gzip_min_length 1024;
gzip_types text/plain text/css application/json application/javascript application/manifest+json image/svg+xml;

ssl_protocols TLSv1.2 TLSv1.3;
ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
ssl_prefer_server_ciphers off;
ssl_session_cache shared:TLS:10m;
ssl_session_timeout 1d;
ssl_session_tickets off;
ssl_certificate /etc/nginx/tls/fullchain.pem;
ssl_certificate_key /etc/nginx/tls/privkey.pem;

# Container health check only; not published.
server {
  listen 127.0.0.1:8081;
  access_log off;
  location = /healthz {
    return 200 "ok\n";
  }
}

# Anything addressed to the bare IP or an unknown name gets no answer, and no
# certificate that would reveal which site lives here.
server {
  listen 80 default_server;
  return 444;
}

server {
  listen 443 ssl default_server;
  ssl_reject_handshake on;
}

server {
  listen 80;
  server_name ${SITE_ADDRESS} preview.${SITE_ADDRESS} grafana-preview.${SITE_ADDRESS};

  if ($deny_direct) {
    return 444;
  }

  # Let's Encrypt HTTP-01, for first issuance and every renewal.
  location ^~ /.well-known/acme-challenge/ {
    root /var/www/certbot;
    default_type text/plain;
    try_files $uri =404;
  }

  location / {
    return 301 https://$host$request_uri;
  }
}

# Production: the tip of main.
server {
  listen 443 ssl;
  http2 on;
  server_name ${SITE_ADDRESS};

  set $frontend http://production-waypoint:3000;
  include /etc/nginx/snippets/site.conf;
}

# Preview: the tip of dev. Answers 502 until the preview stack is running.
server {
  listen 443 ssl;
  http2 on;
  server_name preview.${SITE_ADDRESS};

  add_header X-Robots-Tag "noindex, nofollow" always;

  set $frontend http://preview-waypoint:3000;
  include /etc/nginx/snippets/site.conf;
}

# Preview log search (Grafana). Answers 502 while the preview stack is not
# running the observability profile. Grafana has its own sign-in.
server {
  listen 443 ssl;
  http2 on;
  server_name grafana-preview.${SITE_ADDRESS};

  if ($deny_direct) {
    return 444;
  }

  add_header Strict-Transport-Security "max-age=31536000" always;
  add_header X-Robots-Tag "noindex, nofollow" always;

  set $grafana http://preview-grafana:3000;
  location / {
    include /etc/nginx/snippets/proxy.conf;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_pass $grafana;
  }
}
