# Single origin per environment: browser --HTTPS--> Caddy --http--> frontend:3000.
# /api/* is proxied on to Spring by the Next.js catch-all route, the same path
# local development uses, so no backend is reachable from outside.
#
# Caddy runs once, in the production stack, and fronts both environments over
# the shared `waypoint-edge` network. Each frontend joins that network under its
# own alias, because both stacks call the service `waypoint`.
#
# Caddy obtains and renews the certificates itself and redirects HTTP to HTTPS.
# HTTPS is not optional here: service workers and Secure cookies both need it.

(common) {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy same-origin
		-Server
	}

	# Matches the backend's 4MB limit; proof photos are the largest request.
	request_body {
		max_size 4MB
	}
}

# Production: the tip of main.
{$SITE_ADDRESS} {
	import common
	reverse_proxy production-waypoint:3000
}

# Preview: the tip of dev. Answers 502 until the preview stack is running.
preview.{$SITE_ADDRESS} {
	import common
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy preview-waypoint:3000
}
