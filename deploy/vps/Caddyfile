# Single origin for UI and API: browser --HTTPS--> Caddy --http--> waypoint:3000.
# /api/* is proxied on to Spring by the Next.js catch-all route, the same path
# local development uses, so the backend is never reachable from outside.
#
# Caddy obtains and renews the certificate itself and redirects HTTP to HTTPS.
# HTTPS is not optional here: service workers and Secure cookies both need it.

{$SITE_ADDRESS} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy same-origin
		-Server
	}

	# Matches the backend's 4MB limit; proof photos are the largest request.
	request_body {
		max_size 4MB
	}

	reverse_proxy waypoint:3000
}
