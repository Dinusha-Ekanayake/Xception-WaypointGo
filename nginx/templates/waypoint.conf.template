# Production reverse proxy: single origin for UI + API.
#
#   browser --HTTPS--> nginx --http--> frontend:3000 (everything except /api/*)
#                                \--> backend:8080  (/api/* -> Spring Boot)
#
# Rendered by the stock nginx image (envsubst) from /etc/nginx/templates/.
# The 25-conditional-tls.sh entrypoint hook activates the blocks below
# according to whether a certificate already exists, so the very first boot
# (pre-certificate) serves plain HTTP and every later boot redirects to HTTPS.

# Sign-in is POST /api/session. GET on the same path is "who am I", called on
# every page load, so only POST is keyed: an empty key is not limited.
map $request_method $login_key {
  POST    $binary_remote_addr;
  default "";
}

limit_req_zone $login_key zone=login:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=api:10m rate=60r/s;
# 429 with the problem body below, not nginx's default 503: a client must be able
# to tell "slow down" from "the service is down".
limit_req_status 429;

# Same policy as frontend/next.config.mjs. Next.js emits inline scripts and styles
# without a nonce, so those two stay 'unsafe-inline'; everything else is self only.
map $host $content_security_policy {
  default "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'";
}

# Map tiles (issue #161): the Next route fetches them from MAP_TILE_URL; nginx
# keeps them a week so the provider sees each tile once, not once per viewer.
proxy_cache_path /var/cache/nginx/map-tiles levels=1:2 keys_zone=map_tiles:10m max_size=512m inactive=7d use_temp_path=off;

upstream frontend {
  server frontend:3000 max_fails=3 fail_timeout=10s;
}

upstream backend {
  server backend:8080 max_fails=3 fail_timeout=10s;
}

server {
  listen 80;
  server_name ${DOMAIN};

  location /.well-known/acme-challenge/ {
    root /var/www/certbot;
  }

# BEGIN-REDIRECT
  location / {
    return 301 https://$host$request_uri;
  }
# END-REDIRECT
# BEGIN-FALLBACK
  # Temporary plain-HTTP service until the first certificate is issued.
  # Removed automatically once /etc/letsencrypt/live/${DOMAIN}/ exists.
  client_max_body_size 4m;
  add_header X-Content-Type-Options nosniff always;
  add_header X-Frame-Options DENY always;
  add_header Referrer-Policy same-origin always;
  add_header Content-Security-Policy $content_security_policy always;
  error_page 429 = @rate_limited;
  error_page 413 = @too_large;
  location /api/ {
    proxy_pass http://backend;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 30s;
  }

  # The unread-count stream (issue #118): not buffered, and open past 30 s.
  location = /api/notifications/stream {
    proxy_pass http://backend;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_buffering off;
    proxy_read_timeout 120s;
  }

  # The live map's position stream (R-EXE-23): the same long, unbuffered response.
  location = /api/execution/positions/stream {
    proxy_pass http://backend;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_buffering off;
    proxy_read_timeout 120s;
  }

  location = /api/session {
    limit_req zone=login burst=5 nodelay;
    proxy_pass http://backend;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 30s;
  }

  location /map-tiles/ {
    limit_req zone=api burst=120 nodelay;
    proxy_pass http://frontend;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_cache map_tiles;
    proxy_cache_valid 200 7d;
    proxy_cache_valid 404 502 504 1m;
    proxy_cache_lock on;
    add_header X-Cache-Status $upstream_cache_status always;
  }

  location / {
    proxy_pass http://frontend;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_read_timeout 60s;
  }

  location @rate_limited {
    default_type application/problem+json;
    add_header Retry-After 60 always;
    return 429 '{"type":"urn:waypoint:problem:rate-limited","title":"Too many requests","status":429,"detail":"Too many requests; slow down and retry","instance":"$uri","code":"RATE_LIMITED","correlationId":"","violations":[]}';
  }

  location @too_large {
    default_type application/problem+json;
    return 413 '{"type":"urn:waypoint:problem:payload-too-large","title":"Request too large","status":413,"detail":"The request body exceeds 4 MiB","instance":"$uri","code":"PAYLOAD_TOO_LARGE","correlationId":"","violations":[]}';
  }
# END-FALLBACK
}

# BEGIN-TLS
# HTTPS: single origin keeps session cookies + offline behavior intact.
server {
  listen 443 ssl;
  server_name ${DOMAIN};

  ssl_certificate /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers on;
  ssl_session_cache shared:SSL:10m;
  ssl_session_timeout 1d;

  add_header X-Content-Type-Options nosniff always;
  add_header X-Frame-Options DENY always;
  add_header Referrer-Policy same-origin always;
  add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
  add_header Content-Security-Policy $content_security_policy always;

  client_max_body_size 4m;
  error_page 429 = @rate_limited;
  error_page 413 = @too_large;

  # API -> Spring Boot. Host is forwarded untouched so the backend's
  # same-origin check compares the real browser origin.
  location /api/ {
    limit_req zone=api burst=120 nodelay;
    proxy_pass http://backend;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 30s;
  }

  # The unread-count stream (issue #118): not buffered, and open past 30 s.
  location = /api/notifications/stream {
    limit_req zone=api burst=120 nodelay;
    proxy_pass http://backend;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_buffering off;
    proxy_read_timeout 120s;
  }

  # The live map's position stream (R-EXE-23): the same long, unbuffered response.
  location = /api/execution/positions/stream {
    limit_req zone=api burst=120 nodelay;
    proxy_pass http://backend;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_buffering off;
    proxy_read_timeout 120s;
  }

  # Sign-in gets a tighter rate limit on top of the application's own lockout.
  location = /api/session {
    limit_req zone=login burst=5 nodelay;
    proxy_pass http://backend;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 30s;
  }

  location /map-tiles/ {
    limit_req zone=api burst=120 nodelay;
    proxy_pass http://frontend;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_cache map_tiles;
    proxy_cache_valid 200 7d;
    proxy_cache_valid 404 502 504 1m;
    proxy_cache_lock on;
    add_header X-Cache-Status $upstream_cache_status always;
  }

  location / {
    proxy_pass http://frontend;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_read_timeout 60s;
  }
  location @rate_limited {
    default_type application/problem+json;
    add_header Retry-After 60 always;
    return 429 '{"type":"urn:waypoint:problem:rate-limited","title":"Too many requests","status":429,"detail":"Too many requests; slow down and retry","instance":"$uri","code":"RATE_LIMITED","correlationId":"","violations":[]}';
  }

  location @too_large {
    default_type application/problem+json;
    return 413 '{"type":"urn:waypoint:problem:payload-too-large","title":"Request too large","status":413,"detail":"The request body exceeds 4 MiB","instance":"$uri","code":"PAYLOAD_TOO_LARGE","correlationId":"","violations":[]}';
  }
}
# END-TLS
